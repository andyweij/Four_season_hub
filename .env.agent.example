# Merge required values into the existing Hub .env. Never commit real keys.
# Generate separate random secrets; signing key must be at least 32 characters.
APP_AGENT_SIGNING_KEY=
APP_AGENT_SERVICE_TOKEN=
# Optional task API credentials, keyed by integration.credential_ref:
APP_AGENT_CREDENTIALS={}
# Optional managed Docker service environment, keyed by agent id:
APP_AGENT_RUNTIME_ENVIRONMENT={}
APP_AGENT_GATEWAY_PROFILES=["internal-agent-gateway","third-party-gateway"]
# Optional catalog override:
# APP_AGENT_CATALOG_PATH=resources/agents/agents.json
