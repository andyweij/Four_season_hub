# Four Season Hub — environment variables
# Copy to .env and adjust values as needed.
# All variables use the APP_ prefix.

# Runtime: docker | podman | native
APP_RUNTIME_TYPE=docker

# Model catalog backend: memory | postgres
APP_MODEL_CATALOG_BACKEND=memory

# Path to models.json (used when backend=memory)
APP_MODEL_CATALOG_PATH=resources/models/models.json

# Cache backend: memory | redis
APP_CACHE_BACKEND=memory

# Required when APP_MODEL_CATALOG_BACKEND=postgres
# APP_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fourseason

# Required when APP_CACHE_BACKEND=redis
# APP_REDIS_URL=redis://localhost:6379/0

# Runtime health check interval (seconds)
APP_RUNTIME_CHECK_INTERVAL_SECONDS=10

# Runtime status cache TTL (seconds)
APP_RUNTIME_CACHE_TTL_SECONDS=15

# Root directory containing model artifacts (required)
APP_MODEL_BASE_PATH=/data/models

# Validate model artifacts on application startup
APP_MODEL_ARTIFACT_CHECK_ON_STARTUP=true

# If true, fail startup when any artifact is incomplete
APP_MODEL_ARTIFACT_STRICT_STARTUP=false
