# ============================================================
# 複製這個檔案為 .env，並依照你的環境填入實際的值。
# 所有變數都以 APP_ 開頭（見 Settings.model_config 的 env_prefix）。
# ============================================================

# ---- Runtime / Engine ----
# docker / podman / native
APP_RUNTIME_TYPE=docker
# vLLM or llama_cpp
APP_LLM_ENGINE_TYPE=vllm
APP_MODEL_CATALOG_BACKEND=memory
APP_MODEL_CATALOG_PATH=resources/models/models.json
APP_CACHE_BACKEND=memory

# GPU & INTEL & AMD & MAC (注意：目前 Settings 沒有對應欄位，設定了也不會被讀取（保留是因為現有 .env 有這個變數）)
APP_GPU_PROVIDER=nvidia

# ---- Runtime 監控參數 ----
APP_RUNTIME_CHECK_INTERVAL_SECONDS=15
APP_RUNTIME_CACHE_TTL_SECONDS=15

# 模型啟動健康檢查參數（有預設值，非必填）
# APP_MODEL_HEALTH_CHECK_INTERVAL_SECONDS=5
# APP_MODEL_STARTUP_TIMEOUT_SECONDS=1800

# 模型服務對外的 host（有預設值 localhost，非必填）
# APP_MODEL_ENDPOINT_HOST=localhost

# Windows 範例 ---- 模型 / 引擎路徑（依作業系統擇一設定，必填）----
APP_MODEL_BASE_PATH=C:/Users/User/Documents/workSpace/models
APP_LLM_ENGINE_PATH=D:/workspace/llama-b10644-bin-win-sycl-x64
# 注意：目前 Settings 對應欄位被註解掉了，設定了也不會被讀取（保留是因為現有 .env 有這個變數）
APP_MODEL_ARTIFACT_CHECK_ON_STARTUP=true
APP_MODEL_ARTIFACT_STRICT_STARTUP=false

# Linux 範例
# APP_MODEL_BASE_PATH=/path/to/models
# APP_LLM_ENGINE_PATH=/path/to/llama-engine-bin

# ---- Container ----
APP_CONTAINER_NETWORK_NAME=fourseason_hub_network
APP_CONTAINER_PREFIX=FSH

# ---- MongoDB（必填）----
APP_MONGO_URL=mongodb://localhost:27017
APP_MONGO_DB_NAME=four_season_hub

# ---- PostgreSQL ----
# 只有 APP_MODEL_CATALOG_BACKEND=postgres 時才是必填
APP_DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/four_seasons_hub_db

# ---- Redis（必填，即使 cache_backend=memory 也需要設定，因為欄位型別沒有允許 None）----
APP_REDIS_URL=redis://localhost:6379/0

#keycloak
APP_KEYCLOAK_BASE_URL=http://localhost:8080
APP_KEYCLOAK_REALM=ffm-realm
APP_KEYCLOAK_AUDIENCE=api-relay

APP_KEYCLOAK_ADMIN_CLIENT_ID=api-relay
APP_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-your-secret

APP_CREDENTIAL_ENCRYPTION_KEY_V1="Hc8M2gYl0zZQq5XH4mOGFkbPdDgzNiqRb7qJ2M3d7KQ="
APP_CREDENTIAL_ENCRYPTION_KEY_CURRENT_VERSION=1